{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-catalog-information-system-functions/schemas/entities/information-system-function.json",
  "metamodel_version": "1.0.0",
  "title": "InformationSystemFunction",
  "description": "A defined unit of functional behaviour performed by an information system or one of its components. CR-IS-CAT-01 (post-CR-AR-FMWK-04 merge 2026-10-16); mirrors schemas/entities/information-system-function.json in dea-metamodel. The legacy SF identity is retained for EGV-004 identity continuity; new records should use ISF.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$",
      "examples": [
        "dea:information-system-function-identity-broker-authentication"
      ]
    },
    "type": {
      "type": "string",
      "const": "InformationSystemFunction"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "external_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "$ref": "entity.schema.json#/properties/metadata"
    }
  }
}
